MINDLEAK_DATABASE_URL=postgresql://mindleak_light:mindleak-light-development-only@127.0.0.1:55432/mindleak_light?sslmode=disable
MINDLEAK_DB_POOL_SIZE=8
MINDLEAK_POSTGRES_PORT=55432
MINDLEAK_HTTP_PORT=8088
MINDLEAK_HTTP_TOKEN=mindleak-light-development-token-not-for-production

# Quickstart: no model server or API key required.
MINDLEAK_DECOMPOSITION=sentences
MINDLEAK_RETRIEVAL=keyword

# Recommended upgrade: LM Studio, Ollama, or another OpenAI-compatible provider.
# Enable either feature independently. See docs/MODELS.md for the full setup.
# MINDLEAK_DECOMPOSITION=openai
# MINDLEAK_LLM_URL=http://host.docker.internal:1234/v1
# MINDLEAK_MODEL=your-loaded-chat-model-id
# MINDLEAK_LLM_API_KEY=
# MINDLEAK_RETRIEVAL=vector
# MINDLEAK_EMBED_URL=http://host.docker.internal:1234/v1
# MINDLEAK_EMBED_MODEL=your-loaded-embedding-model-id
# MINDLEAK_EMBED_DIMENSIONS=768
# MINDLEAK_EMBED_API_KEY=
# MINDLEAK_MODEL_TIMEOUT_SECS=60
# Use localhost instead of host.docker.internal when running the binary natively.
# Use the actual embedding dimension for your chosen model, not necessarily 768.

# For remote PostgreSQL, use sslmode=require and optionally a private CA file.
# MINDLEAK_DATABASE_CA_FILE=/absolute/path/to/postgres-ca.pem
